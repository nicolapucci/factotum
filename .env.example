# Copy this file to `.env` and adjust it. Never commit `.env`.

# --- Deployment ----------------------------------------------------------------------------
# `development` and `test` enable developer conveniences such as the development authenticator.
# Anything else refuses them, and leaving the variable unset means production.
FACTOTUM_ENVIRONMENT=development

# single_tenant: on-premise, one tenant created at first start.
# multi_tenant: cloud, one tenant per organization.
FACTOTUM_TENANT_MODE=single_tenant

FACTOTUM_LOG_LEVEL=INFO
# true: one JSON object per line (for machines). false: readable text (for people).
FACTOTUM_LOG_JSON=false

# --- Postgres (read by docker compose) -----------------------------------------------------
FACTOTUM_POSTGRES_USER=factotum
# There is deliberately no default: compose refuses to start until you choose one.
FACTOTUM_POSTGRES_PASSWORD=change-me
FACTOTUM_POSTGRES_DB=factotum
# Published on the loopback interface only.
FACTOTUM_POSTGRES_PORT=5432
# Where the services look for the database (a service in a container uses `postgres`).
FACTOTUM_POSTGRES_HOST=127.0.0.1
FACTOTUM_POSTGRES_POOL_MAX=10

# --- Model gateway ---------------------------------------------------------------------------
# Loopback by default: the gateway is for the other services, never for the outside world.
FACTOTUM_GATEWAY_HOST=127.0.0.1
FACTOTUM_GATEWAY_PORT=8081
# Development only: a YAML file with the model bindings of the development tenant (see
# docs/model-gateway.md), until the hub manages them. Keys are never written in it: a binding
# names an environment variable (`secret_ref: env:OPENAI_API_KEY`) and the variable holds the key.
# FACTOTUM_GATEWAY_BINDINGS_FILE=config/bindings.dev.yaml

# --- Knowledge service ---------------------------------------------------------------------
# Documents in, passages out (see docs/knowledge.md). It uses the database above and asks the
# gateway for every embedding: it never knows a model, a provider or a key.
# Loopback by default: the service is for the other services, never for the outside world.
FACTOTUM_KNOWLEDGE_HOST=127.0.0.1
FACTOTUM_KNOWLEDGE_PORT=8082
# Where the model gateway is (a service in a container uses `http://model-gateway:8081`).
FACTOTUM_KNOWLEDGE_GATEWAY_URL=http://127.0.0.1:8081
# The largest file that is accepted, in MB. The original is kept in the database.
FACTOTUM_KNOWLEDGE_MAX_UPLOAD_MB=25
# Documents read at the same time, in this process. 0: this process only answers requests.
FACTOTUM_KNOWLEDGE_WORKERS=2
# The size of a piece that is searched and of the section around it that comes back, in estimated
# tokens. Make the pieces smaller for an embedding model with a small context.
FACTOTUM_KNOWLEDGE_CHILD_TOKENS=320
FACTOTUM_KNOWLEDGE_PARENT_TOKENS=1200
# Pieces embedded in one request to the gateway.
FACTOTUM_KNOWLEDGE_EMBED_BATCH=32
# Pieces with a vector from which a collection gets a search index. Below it the search is exact.
FACTOTUM_KNOWLEDGE_INDEX_THRESHOLD=2000

# --- Provider keys ---------------------------------------------------------------------------
# A binding never contains a key: it names an environment variable (`secret_ref: env:OPENAI_API_KEY`)
# and the variable holds the key. Docker compose passes these on to the gateway container.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
