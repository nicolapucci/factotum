# Copy this file to `.env` and adjust it. Never commit `.env`.

# --- Deployment ----------------------------------------------------------------------------
# `development` and `test` enable developer conveniences such as the development authenticator.
# Anything else refuses them, and leaving the variable unset means production.
FACTOTUM_ENVIRONMENT=development

# single_tenant: on-premise, one tenant created at first start.
# multi_tenant: cloud, one tenant per organization.
FACTOTUM_TENANT_MODE=single_tenant

FACTOTUM_LOG_LEVEL=INFO
# true: one JSON object per line (for machines). false: readable text (for people).
FACTOTUM_LOG_JSON=false

# --- Postgres (read by docker compose) -----------------------------------------------------
FACTOTUM_POSTGRES_USER=factotum
# There is deliberately no default: compose refuses to start until you choose one.
FACTOTUM_POSTGRES_PASSWORD=change-me
FACTOTUM_POSTGRES_DB=factotum
# Published on the loopback interface only.
FACTOTUM_POSTGRES_PORT=5432
# Where the services look for the database (a service in a container uses `postgres`).
FACTOTUM_POSTGRES_HOST=127.0.0.1
FACTOTUM_POSTGRES_POOL_MAX=10

# --- Model gateway ---------------------------------------------------------------------------
# Loopback by default: the gateway is for the other services, never for the outside world.
FACTOTUM_GATEWAY_HOST=127.0.0.1
FACTOTUM_GATEWAY_PORT=8081
# Development only: a YAML file with the model bindings of the development tenant (see
# docs/model-gateway.md), until the hub manages them. Keys are never written in it: a binding
# names an environment variable (`secret_ref: env:OPENAI_API_KEY`) and the variable holds the key.
# FACTOTUM_GATEWAY_BINDINGS_FILE=config/bindings.dev.yaml

# --- Knowledge service ---------------------------------------------------------------------
# Documents in, passages out (see docs/knowledge.md). It uses the database above and asks the
# gateway for every embedding: it never knows a model, a provider or a key.
# Loopback by default: the service is for the other services, never for the outside world.
FACTOTUM_KNOWLEDGE_HOST=127.0.0.1
FACTOTUM_KNOWLEDGE_PORT=8082
# Where the model gateway is (a service in a container uses `http://model-gateway:8081`).
FACTOTUM_KNOWLEDGE_GATEWAY_URL=http://127.0.0.1:8081
# The largest file that is accepted, in MB. The original is kept in the database.
FACTOTUM_KNOWLEDGE_MAX_UPLOAD_MB=25
# Documents read at the same time, in this process. 0: this process only answers requests.
FACTOTUM_KNOWLEDGE_WORKERS=2
# The size of a piece that is searched and of the section around it that comes back, in estimated
# tokens. Make the pieces smaller for an embedding model with a small context.
FACTOTUM_KNOWLEDGE_CHILD_TOKENS=320
FACTOTUM_KNOWLEDGE_PARENT_TOKENS=1200
# Pieces embedded in one request to the gateway.
FACTOTUM_KNOWLEDGE_EMBED_BATCH=32
# Pieces with a vector from which a collection gets a search index. Below it the search is exact.
FACTOTUM_KNOWLEDGE_INDEX_THRESHOLD=2000

# --- Conversation service --------------------------------------------------------------------
# A message in, an answer streamed out (see docs/conversation.md). A turn carries no history: the
# conversation is saved so that it can be looked up when a message refers to it. It uses the
# database above, asks the gateway for every answer and embedding, and the knowledge service for the
# passages of the documents.
FACTOTUM_CONVERSATION_HOST=127.0.0.1
FACTOTUM_CONVERSATION_PORT=8083
# Where the gateway and the knowledge service are (a service in a container uses
# `http://model-gateway:8081` and `http://knowledge:8082`).
FACTOTUM_CONVERSATION_GATEWAY_URL=http://127.0.0.1:8081
FACTOTUM_CONVERSATION_KNOWLEDGE_URL=http://127.0.0.1:8082
# Where the actions service is: it is asked, before the documents, whether a message asks for
# something to be done (`http://actions:8085` in a container). Without one every message is a
# question. How long it is waited for: the whole of an action, so as long as the model's.
# FACTOTUM_CONVERSATION_ACTIONS_URL=http://127.0.0.1:8085
FACTOTUM_CONVERSATION_ACTIONS_TIMEOUT_S=120
# The time zone of the household: "yesterday" and "last week" are counted in it.
FACTOTUM_CONVERSATION_TIMEZONE=UTC
# How long a conversation stays the one a message that names none belongs to.
FACTOTUM_CONVERSATION_SESSION_MINUTES=30
# How far back (in seconds) a shared device sees what was said on it. A shared device has no history of
# its own, only this window before a message; what is said on it is forgotten after twice as long.
FACTOTUM_CONVERSATION_SHARED_WINDOW_SECONDS=60
# How many of the last exchanges a continuation ("and in English?") brings back, how many a reference
# to something said earlier brings back, and how many passages of the documents a turn asks for.
FACTOTUM_CONVERSATION_RECENT_EXCHANGES=3
FACTOTUM_CONVERSATION_HISTORY_HITS=3
FACTOTUM_CONVERSATION_DOCUMENT_PASSAGES=6
# How long the documents and the small model are waited for, and how long the model may be silent.
FACTOTUM_CONVERSATION_KNOWLEDGE_TIMEOUT_S=4
FACTOTUM_CONVERSATION_GATE_TIMEOUT_S=8
FACTOTUM_CONVERSATION_ANSWER_TIMEOUT_S=120
# How near by meaning an earlier exchange must be to come back when its words are not the ones
# looked for (0 to 1). Models differ in how near unrelated texts are: tune it to yours.
FACTOTUM_CONVERSATION_HISTORY_MIN_SIMILARITY=0.5
# How many days what was said is kept. 0 keeps it until somebody forgets it.
FACTOTUM_CONVERSATION_RETENTION_DAYS=0
# Exchanges embedded in one request, in the background, and how often it looks for more.
FACTOTUM_CONVERSATION_EMBED_BATCH=16
FACTOTUM_CONVERSATION_KEEPER_SECONDS=5

# --- Edge ---------------------------------------------------------------------------------------
# The door of the system devices: they connect to it over a WebSocket, and it asks the conversation
# service for every answer. It knows no model and no document.
FACTOTUM_EDGE_HOST=127.0.0.1
FACTOTUM_EDGE_PORT=8084
FACTOTUM_EDGE_CONVERSATION_URL=http://127.0.0.1:8083
# The devices that may connect, for development (the hub registers them later): copy
# config/devices.example.yaml to config/devices.dev.yaml, adjust it, and name it here. A file that is
# named and is not there stops the edge; without one no device can connect.
# FACTOTUM_EDGE_DEVICES_FILE=config/devices.dev.yaml
# How long a connection may take to say who it is, how often a device with nothing to say is asked to
# say that it is there, and how long it may say nothing at all before it is taken to be gone.
FACTOTUM_EDGE_HELLO_TIMEOUT_S=10
FACTOTUM_EDGE_HEARTBEAT_S=20
FACTOTUM_EDGE_IDLE_TIMEOUT_S=60
# How long a device is given to answer a command, how long the conversation service may be silent
# while it answers, and how long sending one frame to a device may take.
FACTOTUM_EDGE_COMMAND_TIMEOUT_S=10
FACTOTUM_EDGE_TURN_TIMEOUT_S=130
FACTOTUM_EDGE_SEND_TIMEOUT_S=10

# --- Actions ------------------------------------------------------------------------------------
# What a message asks to be done: it chooses a skill, decides whether it may run, asks for a yes
# when it must, and audits what it did. It knows no model and no key: the gateway reads every
# message for it. Until slice 5b a skill is not run: what would have been done is said.
FACTOTUM_ACTIONS_HOST=127.0.0.1
FACTOTUM_ACTIONS_PORT=8085
FACTOTUM_ACTIONS_GATEWAY_URL=http://127.0.0.1:8081
# The devices, and the skills each of them is bound to, for development (the hub registers them
# later): the file the edge reads too. A file that is named and is not there stops the service.
# FACTOTUM_ACTIONS_DEVICES_FILE=config/devices.dev.yaml
# A folder of skills (each a folder with a SKILL.md and its scripts), read again on
# `POST /v1/skills/reload`. A skill runs only when an administrator has reviewed and enabled it;
# for development, this enables what is read from the folder as it is read (it is refused anywhere
# else).
# FACTOTUM_ACTIONS_SKILLS_DIR=skills
FACTOTUM_ACTIONS_ENABLE_SKILLS_DIR=false
# How near, by meaning, a message must be to what a skill says about itself (0 to 1) for the skill
# to be shown to the small model, and how many are shown. Models differ in how near unrelated texts
# are: tune it to yours.
FACTOTUM_ACTIONS_MATCH_THRESHOLD=0.45
FACTOTUM_ACTIONS_MATCH_CANDIDATES=6
# How long the embedding of a message and of a skill are waited for.
FACTOTUM_ACTIONS_MATCH_TIMEOUT_S=4
FACTOTUM_ACTIONS_INDEX_TIMEOUT_S=8
# How long the small model is waited for to read a message, and to read a yes or a no.
FACTOTUM_ACTIONS_PLANNER_TIMEOUT_S=10
FACTOTUM_ACTIONS_READER_TIMEOUT_S=6
# How long a yes or a no is waited for; how long a turn waits for an approver, and how long an
# approval request is open; what is added to the time limit of a skill; how many other devices the
# small model is shown by name.
FACTOTUM_ACTIONS_CONFIRMATION_SECONDS=60
FACTOTUM_ACTIONS_APPROVAL_WAIT_S=20
FACTOTUM_ACTIONS_APPROVAL_MINUTES=10
FACTOTUM_ACTIONS_RUN_MARGIN_S=5
FACTOTUM_ACTIONS_MAX_DEVICES_SHOWN=10

# --- Egress -------------------------------------------------------------------------------------
# The only way out of the sandbox of a skill: a proxy on a network that has nothing else on it. It
# lets a run reach the hosts that its grant lists (signed by the runner with the key below) and
# nothing else: not this machine, not a metadata service, not a private address unless the host is
# named. The same key goes to the runner; nothing else gets it.
FACTOTUM_EGRESS_HOST=127.0.0.1
FACTOTUM_EGRESS_PORT=3128
# At least 32 characters (`python -c "import secrets; print(secrets.token_urlsafe(32))"`).
# FACTOTUM_EGRESS_KEY=
# The ports that a tunnel (https) may be made to, and how many runs are served at once.
FACTOTUM_EGRESS_CONNECT_PORTS=443
FACTOTUM_EGRESS_MAX_CONNECTIONS=64
# How long a request may take to say what it is, how long a host may take to answer, how long a
# connection may be silent, how long it may last, and how much may go through it (MB).
FACTOTUM_EGRESS_HEADER_TIMEOUT_S=10
FACTOTUM_EGRESS_CONNECT_TIMEOUT_S=10
FACTOTUM_EGRESS_IDLE_TIMEOUT_S=30
FACTOTUM_EGRESS_MAX_DURATION_S=130
FACTOTUM_EGRESS_MAX_MB=20

# --- Provider keys ---------------------------------------------------------------------------
# A binding never contains a key: it names an environment variable (`secret_ref: env:OPENAI_API_KEY`)
# and the variable holds the key. Docker compose passes these on to the gateway container.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
